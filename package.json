{
  "name": "share.git",
  "private": true,
  "version": "1.1.0",
  "description": "PAT-free read-only repository sharing with a GitHub Pages frontend",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --config tools/config/vite.config.ts && node tools/script/pages.mts",
    "check": "biome check src tests tools/script tools/config/*.ts worker.ts",
    "dev": "vite dev --config tools/config/vite.config.ts --port 3000",
    "format": "biome format src tests tools/script tools/config/*.ts worker.ts",
    "lint": "biome lint src tests tools/script tools/config/*.ts worker.ts",
    "preview": "vite preview --config tools/config/vite.config.ts",
    "test": "vitest run --config tools/config/vitest.config.ts && node --test tests/share.test.ts",
    "test:watch": "vitest --config tools/config/vitest.config.ts",
    "test:coverage": "vitest run --config tools/config/vitest.config.ts --coverage",
    "test:ui": "vitest --config tools/config/vitest.config.ts --ui",
    "typecheck": "tsc --project tools/config/tsconfig.json --noEmit",
    "validate": "npm run check && npm run typecheck && npm test && npm run test:pages",
    "deploy": "wrangler deploy --config tools/config/wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply shares --config tools/config/wrangler.jsonc --local --persist-to .wrangler/state",
    "dev:api": "wrangler dev --config tools/config/wrangler.jsonc --persist-to .wrangler/state --port 8787",
    "test:pages": "node --test tests/pages.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@octokit/core": "7.0.8",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "2.2.4",
    "@keys-i/seer": "1.2.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^27.0.0",
    "msw": "^2.12.7",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  }
}
