{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "private-share-link",
  "main": "../../worker.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.share.keysi.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shares",
      "migrations_dir": "../../migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "SITE_ORIGIN": "https://share.keysi.dev"
  }
}
